<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee"
         xmlns:xsi="http://www.w3.org"
         xsi:schemaLocation="https://jakarta.ee https://jakarta.ee/web-app_6_0.xsd"
         version="6.0">

    <servlet>
        <servlet-name>JerseyServlet</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <!-- Указываем Jersey, где искать ваш конфиг -->
        <init-param>
            <param-name>jakarta.ws.rs.Application</param-name>
            <param-value>com.iprody.library.config.ApplicationConfig</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>JerseyServlet</servlet-name>
        <!-- Все запросы будут идти через Jersey -->
        <url-pattern>/*</url-pattern>
    </servlet-mapping>
</web-app>